          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-aws--a4" value="save_products()&lt;br&gt;put_object" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="3-aws--lam" target="3-aws--s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-aws--a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="3-aws--lam" target="3-aws--logic">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-aws--a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="3-aws--gw" target="3-aws--res">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-aws--a7" value="assumed by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="3-aws--iam" target="3-aws--lam">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-aws--why" value="&lt;b&gt;Why S3?&lt;/b&gt; Lambda is stateless and can't keep a local file between runs, so products.json lives in S3.&lt;br&gt;&lt;b&gt;Gotcha:&lt;/b&gt; 'Missing Authentication Token' means the route wasn't found: check the stage in the URL and Deploy API." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="160" y="590" width="1000" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="3-aws--vs" value="&lt;b&gt;vs flask-json&lt;/b&gt;: same CRUD logic. Runs on demand, pay per request, scales automatically, ~30 min setup." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="160" y="680" width="1000" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
