          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-aws--a2" value="event (proxy)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="3-aws--gw" target="3-aws--lam">
