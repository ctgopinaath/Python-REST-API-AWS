        </mxCell>
        <mxCell id="4-e-co-s6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="880" y="540" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="4-e-co-steps" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;1. Client POSTs an order &amp;rarr; API Gateway&lt;br&gt;2. FastAPI validates, stores in memory, publishes OrderPlaced, returns 201 right away&lt;br&gt;3. EventBridge rule matches and forwards to SNS&lt;br&gt;4. SNS fans out to SQS (and email)&lt;br&gt;5. SQS buffers, retries 3x, then DLQ&lt;br&gt;6. Worker Lambda processes the batch and logs to CloudWatch" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="170" y="880" width="760" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="4-e-co-local" value="&lt;b&gt;Run locally:&lt;/b&gt; leave EVENT_BUS_NAME unset &amp;rarr; uvicorn app:app &amp;rarr; publish_order_placed() only prints" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="960" y="880" width="690" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
